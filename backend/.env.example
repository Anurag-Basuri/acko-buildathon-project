# Contract Guard backend configuration.
# Copy this file to .env and fill in real values. Never commit .env.

# Database connection string.
# Local Postgres (dev):  postgresql://USER:PASSWORD@localhost:5432/contractguard?schema=public
# Neon (hosted):         postgresql://USER:PASSWORD@ep-xxx.<region>.aws.neon.tech/contractguard?sslmode=require
DATABASE_URL="postgresql://contractguard:contractguard@localhost:5432/contractguard?schema=public"

# HTTP
PORT=3000
NODE_ENV=development

# Webhook receiver from the starter kit (starts on host port 9900 via docker compose)
WEBHOOK_TARGET_URL=http://localhost:9900
