generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Increment 1: Service Registry (Service).
// Increment 2: Specification Management (ApiVersion).
// Increment 5: Consumer Registry and Dependency Management (ConsumerDependency).
// The remaining models from the approved data model (AnalysisRun,
// CompatibilityChange, ImpactFinding, PublishAttempt) are added in later
// increments, one per feature module.

model Service {
  id          String   @id @default(uuid())
  name        String   @unique
  owner       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  apiVersions          ApiVersion[]
  consumerDependencies ConsumerDependency[] @relation("ConsumerDependencyConsumer")
  providedDependencies ConsumerDependency[] @relation("ConsumerDependencyProvider")
}

enum SpecFormat {
  YAML
  JSON
}

enum VersionStatus {
  PROPOSED
  PUBLISHED
}

model ApiVersion {
  id        String @id @default(uuid())
  serviceId String
  // User-supplied identifier (e.g. "v1", "2026.11"). Not assumed to sort
  // lexicographically; "latest" is tracked by the publish flow, not by label.
  versionLabel    String
  // The exact content as uploaded, preserved for display/download/audit.
  originalContent String
  // Parsed and fully $ref-resolved document, stored as normalized JSON for
  // consistent comparison in the (later) diffing engine.
  parsedContent   Json
  format          SpecFormat
  // Detected OpenAPI version string, e.g. "3.0.3".
  openApiVersion  String
  status          VersionStatus @default(PROPOSED)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, versionLabel])
}

// Increment 5: one declared usage of a provider operation by a consumer.
// Both consumer and provider are Service records (a service can act as both).
// The unique constraint prevents accidental duplicate declarations for the
// same consumer, provider, method and operation path.
model ConsumerDependency {
  id                String   @id @default(uuid())
  consumerServiceId String
  providerServiceId String
  // Normalized uppercase HTTP method (GET, POST, ...).
  method            String
  // The operation path exactly as the consumer declares it, e.g. /quotes/{id}.
  path              String
  // Request field paths the consumer sends, in the starter-kit dot-notation
  // with array markers (e.g. "vehicle.make", "items[].productId"). Preserved
  // verbatim — never flattened or discarded.
  sends             String[]
  // Response field paths the consumer reads, same representation.
  reads             String[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  consumer Service @relation("ConsumerDependencyConsumer", fields: [consumerServiceId], references: [id], onDelete: Cascade)
  provider Service @relation("ConsumerDependencyProvider", fields: [providerServiceId], references: [id], onDelete: Cascade)

  @@unique([consumerServiceId, providerServiceId, method, path])
  // Provider-side lookups (GET /api/services/:id/consumers); the consumer-side
  // lookups use the leftmost prefix of the unique index above.
  @@index([providerServiceId])
}
